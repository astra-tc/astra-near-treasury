{
  "name": "astra-near-treasury",
  "private": true,
  "version": "0.1.0",
  "description": "Astra Treasury \u2014 agent-run company with a hard-capped NEAR spend-guard",
  "scripts": {
    "test:x402": "pnpm --filter @astra-near/x402 test",
    "test:agents": "pnpm --filter @astra-near/agents test",
    "test:intents": "pnpm --filter @astra-near/intents test",
    "test:node": "pnpm test:x402 && pnpm test:agents && pnpm test:intents",
    "test:rust": "cargo test --manifest-path contracts/spend_guard/Cargo.toml",
    "test": "pnpm test:node",
    "demo": "node --experimental-strip-types ./scripts/demo.ts",
    "quote:live": "pnpm --filter @astra-near/intents quote:live"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "type": "module"
}
